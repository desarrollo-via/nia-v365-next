--- a/.github/workflows/main_nia-v365-next-api.yml
+++ b/.github/workflows/main_nia-v365-next-api.yml
@@ -29,5 +29,10 @@ jobs:
       - name: Create and Start virtual environment and Install dependencies
         run: |
           python -m venv antenv
           source antenv/bin/activate
           pip install -r requirements.txt
+
+      - name: Validate optional Bitrix supervisor without processes
+        run: |
+          source antenv/bin/activate
+          python -m unittest tests.test_nia_process_launcher tests.test_nia_process_supervisor tests.test_optional_bitrix_connector
